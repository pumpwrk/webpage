doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    block title
      title Pumpwrk
    block meta
    link(rel='preconnect', href='https://fonts.googleapis.com')
    link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Russo+One&display=swap', rel='stylesheet')
    link(rel='stylesheet', href='/assets/css/styles.css')
    block extra-head
  body
    block nav
      nav.nav
        div.nav-inner
          a.nav-logo(href='/')
            img(src='/assets/images/logo.png', alt='Pumpwrk Logo')
            span Pumpwrk
          button.nav-toggle(aria-label='Toggle menu', onclick="document.querySelector('.nav-links').classList.toggle('open')")
            svg(width='24', height='24', viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='2', stroke-linecap='round', stroke-linejoin='round')
              line(x1='3', y1='6', x2='21', y2='6')
              line(x1='3', y1='12', x2='21', y2='12')
              line(x1='3', y1='18', x2='21', y2='18')
          ul.nav-links
            li: a(href='#features') Características
            li: a(href='#how-it-works') Cómo funciona
            li: a(href='#benefits') Beneficios
            li: a(href='#download') Descargar
            li: a(href='#pricing') Planes

    block content

    block footer
      footer.footer
        div.container
          div.footer-inner
            div.footer-brand
              img(src='/assets/images/logo-text.png', alt='Pumpwrk Logo')
            div.footer-links
              div
                h4 Legal
                ul
                  li: a(href='/pages/terminos-y-condiciones.html') Términos y Condiciones
                  li: a(href='/pages/politica-de-privacidad.html') Política de Privacidad
                  li: a(href='/pages/politica-de-cookies.html') Política de Cookies
                  li: a(href='/pages/licencia.html') Licencia
              div
                h4 Producto
                ul
                  li: a(href='#features') Características
                  li: a(href='#how-it-works') Cómo funciona
                  li: a(href='#download') Descargar
              div
                h4 Contacto
                ul
                  li: a(href='mailto:hola@pumpwrk.com') hola@pumpwrk.com
          div.footer-bottom
            p &copy; 2026 Pumpwrk. Todos los derechos reservados.

    script.
      function showTab(tab) {
        document.querySelectorAll('.feature-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.feature-panel').forEach(p => p.classList.remove('active'));
        document.getElementById('panel-' + tab).classList.add('active');
        event.target.classList.add('active');
      }

      // Smooth scroll for nav links
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            document.querySelector('.nav-links').classList.remove('open');
          }
        });
      });

    block scripts
